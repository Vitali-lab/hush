<Window x:Class="Hush.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Hush.Windows.Services"
        Title="Hush"
        Width="960" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">
    <Border CornerRadius="16"
            Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.32" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" CornerRadius="16,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,30,18,22">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A78BFA" Offset="0"/>
                                        <GradientStop Color="#F472B6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="H" Foreground="White" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Hush" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [Tagline], Source={x:Static svc:Loc.Instance}}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,0">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="General" IsChecked="True" Checked="Nav_Checked"
                                     Content="{Binding [NavGeneral], Source={x:Static svc:Loc.Instance}}"/>
                        <RadioButton x:Name="NavModel" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="Model" Checked="Nav_Checked"
                                     Content="{Binding [NavModel], Source={x:Static svc:Loc.Instance}}"/>
                        <RadioButton x:Name="NavWords" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="Words" Checked="Nav_Checked"
                                     Content="{Binding [NavWords], Source={x:Static svc:Loc.Instance}}"/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="History" Checked="Nav_Checked"
                                     Content="{Binding [NavHistory], Source={x:Static svc:Loc.Instance}}"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="About" Checked="Nav_Checked"
                                     Content="{Binding [NavAbout], Source={x:Static svc:Loc.Instance}}"/>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,0,14,16" Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Green}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModelStatusTitle}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding VersionText}" FontSize="10.5" Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="30,4,22,18">
                    <!-- General -->
                    <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding [GeneralTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H1Style}"/>
                            <TextBlock Text="{Binding [GeneralSubtitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource CardStyle}" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SetupTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                    <TextBlock Text="{Binding [SetupSubtitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,2,0,0"/>
                                    <Border Style="{StaticResource DividerStyle}"/>

                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [SetupMic], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                            <TextBlock Text="{Binding [MicHelp], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                            <TextBlock Text="{Binding MicError}" Foreground="{DynamicResource Danger}" FontSize="10.5"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding MicError, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding [SetupMicOpen], Source={x:Static svc:Loc.Instance}}"
                                                Style="{StaticResource SecondaryButton}" Click="OpenMic_Click" VerticalAlignment="Top"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [SetupModel], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                            <TextBlock Text="{Binding ModelStatusDetail}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding [SetupChoose], Source={x:Static svc:Loc.Instance}}"
                                                Style="{StaticResource SecondaryButton}" Click="GoModel_Click" VerticalAlignment="Top"/>
                                    </Grid>

                                    <TextBlock Text="{Binding [SetupNote], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding [ShortcutTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                        <TextBlock Text="{Binding [ShortcutHint], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⌨" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding HotkeyText}" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="1" Content="{Binding HotkeyButtonText}" Style="{StaticResource PrimaryButton}"
                                                Click="RecordHotkey_Click" Width="108" Margin="8,0,0,0"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <RadioButton Content="{Binding [ShortcutHold], Source={x:Static svc:Loc.Instance}}"
                                                     Style="{StaticResource ChoiceRadio}" GroupName="HotkeyMode"
                                                     IsChecked="{Binding IsHoldMode, Mode=TwoWay}"/>
                                        <RadioButton Content="{Binding [ShortcutToggle], Source={x:Static svc:Loc.Instance}}"
                                                     Style="{StaticResource ChoiceRadio}" GroupName="HotkeyMode"
                                                     IsChecked="{Binding IsToggleMode, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding HotkeyPresets}" Margin="0,9,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Display}" Tag="{Binding Binding}"
                                                        Click="HotkeyPreset_Click" Style="{StaticResource SecondaryButton}"
                                                        Margin="0,0,6,0" Padding="9,4" FontSize="10.5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding [ShortcutLetters], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding [ShortcutFnNote], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding HotkeyError}" Foreground="{DynamicResource Danger}" FontSize="10.5"
                                               Margin="0,6,0,0" Visibility="{Binding HotkeyError, Converter={StaticResource StringToVis}}"/>
                                    <TextBlock Text="{Binding HookError}" Foreground="{DynamicResource Amber}" FontSize="10.5"
                                               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HookError, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [LanguageTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                    <ListBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                             Style="{StaticResource ChoiceListBox}" Margin="0,10,0,0">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding [LanguageHint], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [ThemeTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                    <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                             Style="{StaticResource ChoiceListBox}" Margin="0,10,0,0">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="82">
                                                    <Border Height="30" CornerRadius="7" Background="{Binding Swatch}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" TextAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding [ThemeHint], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [BehaviorTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [AutoPaste], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                            <TextBlock Text="{Binding [AutoPasteDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoPaste}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Style="{StaticResource DividerStyle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Fillers], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                            <TextBlock Text="{Binding [FillersDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RemoveFillers}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Style="{StaticResource DividerStyle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [SoundFeedback], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                            <TextBlock Text="{Binding [SoundFeedbackDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PlayFeedbackSound}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0" Visibility="{Binding ShowSoundPicker, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [SoundStart], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                        <ListBox Grid.Column="1" ItemsSource="{Binding Sounds}" SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                                 Style="{StaticResource ChoiceListBox}" HorizontalAlignment="Right">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{DynamicResource TextPrimary}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    <Border Style="{StaticResource DividerStyle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [LaunchAtLogin], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                            <TextBlock Text="{Binding [LaunchAtLoginDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchAtLogin}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [FooterPrivacy], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="2,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Model -->
                    <ScrollViewer x:Name="ModelPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding [ModelTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H1Style}"/>
                            <TextBlock Text="{Binding [ModelSubtitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentModelName}" Style="{StaticResource H2Style}"/>
                                            <TextBlock Text="{Binding ModelStatusDetail}" Style="{StaticResource MutedStyle}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ModelStatusTitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding DownloadingName}" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"
                                               Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                    <ProgressBar Style="{StaticResource FlatProgress}" Maximum="100" Value="{Binding DownloadProgress}"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DownloadError}" Foreground="{DynamicResource Danger}" FontSize="10.5"
                                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding DownloadError, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [ModelsAvailable], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SectionStyle}"/>
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3Style}"/>
                                                        <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left" Margin="8,0,0,0"
                                                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding [ModelRecommended], Source={x:Static svc:Loc.Instance}}"
                                                                       FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedStyle}" Margin="0,3,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource LabelStyle}" Margin="0,0,14,0"/>
                                                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource Green}" Margin="0,0,14,0"/>
                                                        <TextBlock Text="{Binding AccuracyText}" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource Accent}"/>
                                                    </StackPanel>
                                                    <ProgressBar Style="{StaticResource FlatProgress}" Maximum="100" Value="{Binding Progress}"
                                                                 Margin="0,7,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                                                    <Button Content="{Binding ActionText}" Tag="{Binding}" Click="ModelAction_Click"
                                                            Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanAct}" Width="144"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource LabelStyle}" Margin="2,0,0,10">
                                <Run Text="{Binding [ModelsOnDisk], Source={x:Static svc:Loc.Instance}}"/>
                                <Run Text="{Binding ModelsOnDiskText}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Words -->
                    <ScrollViewer x:Name="WordsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding [WordsTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H1Style}"/>
                            <TextBlock Text="{Binding [WordsSubtitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [CustomWords], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                            <TextBlock Text="{Binding [CustomWordsDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding [Add], Source={x:Static svc:Loc.Instance}}"
                                                Style="{StaticResource SecondaryButton}" Click="AddWord_Click" VerticalAlignment="Top"/>
                                    </Grid>

                                    <TextBlock Text="{Binding [NoWords], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,14,0,0"
                                               Visibility="{Binding HasWords, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding Dictionary}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Spoken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}"
                                                             ToolTip="{Binding [HeardAs], Source={x:Static svc:Loc.Instance}}" TextChanged="WordTextChanged"/>
                                                    <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Written, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}"
                                                             ToolTip="{Binding [WriteAs], Source={x:Static svc:Loc.Instance}}" TextChanged="WordTextChanged"/>
                                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                            Click="RemoveWord_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Snippets], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                            <TextBlock Text="{Binding [SnippetsDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding [Add], Source={x:Static svc:Loc.Instance}}"
                                                Style="{StaticResource SecondaryButton}" Click="AddSnippet_Click" VerticalAlignment="Top"/>
                                    </Grid>

                                    <TextBlock Text="{Binding [NoSnippets], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,14,0,0"
                                               Visibility="{Binding HasSnippets, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding Snippets}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBox Text="{Binding Trigger, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}"
                                                                 ToolTip="{Binding [Trigger], Source={x:Static svc:Loc.Instance}}" TextChanged="WordTextChanged" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding Expansion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}"
                                                                 ToolTip="{Binding [Expansion], Source={x:Static svc:Loc.Instance}}" TextChanged="WordTextChanged"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButton}" Tag="{Binding}"
                                                            Click="RemoveSnippet_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- History -->
                    <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding [HistoryTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H1Style}"/>
                            <TextBlock Text="{Binding [HistorySubtitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,4,0,18"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TodayWords}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="{Binding [WordsToday], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource LabelStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalWords}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Green}"/>
                                        <TextBlock Text="{Binding [WordsTotal], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource LabelStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="7,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SavedMinutes}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Pink}"/>
                                        <TextBlock Text="{Binding [MinutesSaved], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource LabelStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBox Text="{Binding HistoryQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}"
                                     ToolTip="{Binding [SearchHistory], Source={x:Static svc:Loc.Instance}}" Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding [NothingDictated], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}" Margin="0,20,0,0"
                                       HorizontalAlignment="Center" Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding [NothingDictatedDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" TextAlignment="Center"
                                       Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding FilteredHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM, HH:mm}}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding AppName}" Style="{StaticResource LabelStyle}" Margin="0,0,10,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                                    <Button Content="{Binding [Copy], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource GhostButton}"
                                                            Tag="{Binding}" Click="CopyHistory_Click"/>
                                                    <Button Content="✕" Style="{StaticResource IconButton}" Tag="{Binding}" Click="DeleteHistory_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{Binding [ClearHistory], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left" Click="ClearHistory_Click" Margin="0,0,0,12"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- About -->
                    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding [AboutTitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H1Style}"/>
                            <TextBlock Text="{Binding [AboutSubtitle], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#A78BFA" Offset="0"/>
                                                    <GradientStop Color="#F472B6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="H" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hush" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Style="{StaticResource LabelStyle}">
                                                <Run Text="{Binding [Version], Source={x:Static svc:Loc.Instance}}"/>
                                                <Run Text="{Binding VersionText}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding [License], Source={x:Static svc:Loc.Instance}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [AboutDescription], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [UnderTheHood], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                    <TextBlock Text="{Binding [AboutWhisper], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding [AboutWhisperDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                    <TextBlock Text="{Binding [AboutRam], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding [AboutRamDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                    <TextBlock Text="{Binding [AboutOffline], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding [AboutOfflineDetail], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource MutedStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [Shortcuts], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H2Style}"/>
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{Binding [ShortcutStartStop], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                        <TextBlock Text="{Binding HotkeyDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock Text="{Binding [ShortcutCancelRecording], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                        <TextBlock Text="Esc" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock Text="{Binding [ShortcutOpenSettings], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource H3Style}"/>
                                        <TextBlock Text="Hush" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="GitHub" Style="{StaticResource SecondaryButton}" Click="OpenGitHub_Click"/>
                                <TextBlock Text="{Binding [Credits], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
